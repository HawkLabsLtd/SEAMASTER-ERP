DATABASE_URL=sqlite:///instance/seamaster.db
# Leave empty to auto-generate one in instance/.secret_key
SECRET_KEY=
# production (default) or development
FLASK_ENV=production
GEMINI_API_KEY=
# Optional: password used by `flask --app app create-admin NAME` (prompts when empty)
SEAMASTER_ADMIN_PASSWORD=
# Off by default; set to 1 to re-enable the public /register page
ALLOW_SELF_REGISTRATION=0
# Off by default; set to 1 to allow POST /seed/fa (drops every table - dev only)
ALLOW_DESTRUCTIVE_SEED=0
# Reverse proxies in front of the app that set X-Forwarded-For/-Proto (nginx = 1; 0 when run directly)
TRUSTED_PROXY_COUNT=1
# Branding shown in the UI and the AI assistant prompt
ORG_NAME=سازمان نمونه
APP_TITLE=سامانه داشبورد مدیریتی
# Where dashboard data files (CSV/Excel) live; defaults to ./data
# SEAMASTER_DATA_DIR=/var/lib/seamaster/data
